# ─── DATABASE ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string (get from Supabase → Project Settings → Database → URI)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Any long random string — change before going to production
JWT_SECRET="replace_with_a_long_random_secret_string"

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── ADMIN ────────────────────────────────────────────────────────────────────
# Secret code required during admin signup
ADMIN_ACCESS_CODE="YOUR_ADMIN_CODE_HERE"

# ─── OPENAI (AI Chat — optional) ──────────────────────────────────────────────
# Uncomment and fill in when enabling AI chat features
# OPENAI_API_KEY="sk-..."
